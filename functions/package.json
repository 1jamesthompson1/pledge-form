{
  "name": "te-ra-pledge-functions",
  "version": "0.6.3",
  "description": "Azure Functions backend for the Te Ra pledge form",
  "main": "src/functions/*.js",
  "type": "module",
  "scripts": {
    "start": "func start",
    "sync:config": "node scripts/sync-config.js",
    "prestart": "npm run sync:config",
    "test": "node scripts/pdf-smoke-test.js",
    "test:parity": "node --test \"test/parity/**/*.test.js\"",
    "test:backend": "npm run sync:config && node --test --test-concurrency=1 \"test/backend/**/*.test.js\"",
    "test:e2e": "npm --prefix .. run build && npm run sync:config && node --test --test-concurrency=1 \"test/e2e/**/*.test.js\""
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/functions": "^4.5.0",
    "@azure/identity": "^4.4.0",
    "@azure/storage-blob": "^12.33.0",
    "@sparticuz/chromium": "^149.0.0",
    "puppeteer-core": "^25.5.0"
  },
  "devDependencies": {
    "azure-functions-core-tools": "^4.14.0",
    "azurite": "^3.37.0"
  }
}
