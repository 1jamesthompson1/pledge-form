# Copy this file to .env for local development.
# The dev server injects these values as window.PLEDGE_CONFIG.
VITE_SUBMIT_URL=http://localhost:7071/api/pledges
VITE_CONTACT_EMAIL=office@tera.school.nz
VITE_DEV=true
VITE_DRAFT=true

# Function App to deploy to with `npm run deploy:functions` and `npm run release`.
# Set this in your local .env only — never commit a real app name.
AZURE_FUNCTIONAPP_NAME=
